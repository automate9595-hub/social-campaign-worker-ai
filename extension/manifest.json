{
  "manifest_version": 3,
  "name": "Social Campaign Worker",
  "version": "1.9.0",
  "description": "Publica en tus grupos de Facebook las tareas programadas en tu panel Social Campaign.",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Social Campaign Worker",
    "default_icon": {
      "48": "icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*"
      ],
      "js": [
        "fb.js",
        "capture.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.workers.dev/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}